# Optional override for the Node-RED API URL.
# Default uses Vite dev proxy: /api/cart-status -> http://localhost:1880/api/cart-status
VITE_CART_STATUS_URL=/api/cart-status

# Optional MQTT health endpoint (Node-RED). Falls back to live data freshness if unavailable.
VITE_MQTT_HEALTH_URL=/api/mqtt-health

# InfluxDB health check. Dev proxy: /influx/health -> http://localhost:8086/health
VITE_INFLUX_HEALTH_URL=/influx/health
